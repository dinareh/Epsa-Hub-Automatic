--// Save System
local SettingsFolder = 'EspaHubAutomatic'
local SettingsFilePath = SettingsFolder .. "/Settings.json"
local http = game:GetService("HttpService")

local function GetSettingsPath()
    if isfolder and makefolder and writefile and readfile then
        if not isfolder(SettingsFolder) then
            makefolder(SettingsFolder)
        end
        return SettingsFilePath
    end
    return nil
end

--// Default Settings
local DefaultSettings = {
    AutoBuyEgg = false,
    AutoBuyEgg2 = false,
    x3Eggs = false,
    x8Eggs = false,
    MaxEggs = false,
    AutoFarm = false,
    ClaimOrbs = false,
    EggName = 'Cracked Egg',
    EggDelay = 1,
    EggAmount = 1,
    FarmMode = 'Nearest',
    NearestCount = 10,
    TargetName = 'Chest'
}

--// Load Settings
local function LoadSettings()
    local path = GetSettingsPath()
    if path and isfile(path) then
        local success, data = pcall(function()
            return http:JSONDecode(readfile(path))
        end)
        if success and type(data) == "table" then
            return data
        end
    end
    return {}
end

local SavedSettings = LoadSettings()
local Settings = {}

for k, v in pairs(DefaultSettings) do
    Settings[k] = SavedSettings[k] ~= nil and SavedSettings[k] or v
end

--// Apply Settings
local EggName = Settings.EggName
local EggDelay = Settings.EggDelay
local EggAmount = Settings.EggAmount
local FarmMode = Settings.FarmMode
local NearestCount = Settings.NearestCount
local TargetName = Settings.TargetName
local AutoBuyEgg = Settings.AutoBuyEgg
local AutoBuyEgg2 = Settings.AutoBuyEgg2
local x3Eggs = Settings.x3Eggs
local x8Eggs = Settings.x8Eggs
local MaxEggs = Settings.MaxEggs
local AutoFarm = Settings.AutoFarm
local ClaimOrbs = Settings.ClaimOrbs

--// Save Function
local function SaveCurrentSettings()
    Settings.AutoBuyEgg = AutoBuyEgg
    Settings.AutoBuyEgg2 = AutoBuyEgg2
    Settings.x3Eggs = x3Eggs
    Settings.x8Eggs = x8Eggs
    Settings.MaxEggs = MaxEggs
    Settings.AutoFarm = AutoFarm
    Settings.ClaimOrbs = ClaimOrbs
    Settings.EggName = EggName
    Settings.EggDelay = EggDelay
    Settings.EggAmount = EggAmount
    Settings.FarmMode = FarmMode
    Settings.NearestCount = NearestCount
    Settings.TargetName = TargetName
    
    local path = GetSettingsPath()
    if path then
        pcall(function()
            writefile(path, http:JSONEncode(Settings))
        end)
    end
end

--// Libraries
