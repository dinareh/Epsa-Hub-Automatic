local function GetSelectedUIDs()
    local text = UIDInput and UIDInput:GetValue() or SelectedUIDsSaved
    if not text or text == "" then return {} end
    local uids = {}
    for uid in string.gmatch(text, "([^,]+)") do
        uid = string.gsub(uid, "%s+", "")
        if uid ~= "" then table.insert(uids, uid) end
    end
    return uids
end

local function AddUIDToInput(uid)
    local current = UIDInput and UIDInput:GetValue() or SelectedUIDsSaved
    for u in string.gmatch(current, "([^,]+)") do
        if string.gsub(u, "%s+", "") == uid then return end
    end
    local updated = (current == "") and uid or (current .. ", " .. uid)
    SelectedUIDsSaved = updated
    if UIDInput then pcall(function() UIDInput:SetValue(updated) end) end
    SaveCurrentSettings()
end

EnchantTab:Separator({ Text = "Settings" })
EnchantTab:InputText({ Label = 'Speed (seconds)', PlaceHolder = '1.5', Value = tostring(EnchantDelay),
    Callback = function(self) local val = tonumber(self:GetValue()); if val and val > 0 then EnchantDelay = val; SaveCurrentSettings() end end })
EnchantTab:Checkbox({ Label = 'Auto Enchant', Value = AutoEnchant,
    Callback = function(self, Value) AutoEnchant = Value; _G.AutoEnchant = Value; SaveCurrentSettings() end })

local function BuildEnchantList()
    local PowersByCategory = {}
    for powerName, powerData in pairs(Directory.Powers) do
        if powerData.canDrop ~= false then
            local category = powerData.Name or "Other"
            if not PowersByCategory[category] then PowersByCategory[category] = {} end
            table.insert(PowersByCategory[category], { Name = powerName, Data = powerData })
        end
    end
    EnchantTab:Separator({ Text = "Enchants" })
    for category, powers in pairs(PowersByCategory) do
        local Header = EnchantTab:CollapsingHeader({ Title = category })
        for _, power in ipairs(powers) do
            local powerName = power.Name
            local maxLevel = #power.Data.tiers
            local PowerHeader = Header:CollapsingHeader({ Title = powerName })
            TargetEnchants[powerName] = TargetEnchants[powerName] or {}
            for level = 1, maxLevel do
                local tierTitle = power.Data.tiers[level].title or ("Level " .. level)
                PowerHeader:Checkbox({
                    Label = tierTitle,
                    Value = TargetEnchants[powerName][level] or false,
                    Callback = function(self, Value)
                        TargetEnchants[powerName][level] = Value
                        SaveCurrentSettings()
                    end
                })
            end
        end
    end
end

local PetButtons = {}
local SearchQuery = ""

local function BuildPetList()
    local Data = Save.Get()
    if not Data or not Data.Pets then return end
    local EligiblePets = {}
    for _, pet in ipairs(Data.Pets) do
        if GetPetEligible(pet) then table.insert(EligiblePets, pet) end
    end
    table.sort(EligiblePets, function(a, b)
        local nameA = a.nk or (Directory.Pets[a.id] and Directory.Pets[a.id].name) or "Unknown"
        local nameB = b.nk or (Directory.Pets[b.id] and Directory.Pets[b.id].name) or "Unknown"
        return nameA < nameB
    end)
    for _, pet in ipairs(EligiblePets) do
        local def = Directory.Pets[pet.id]
        local petName = def.name
        if pet.r then petName = "Rainbow " .. petName
        elseif pet.g then petName = "Golden " .. petName end
        if pet.dm then petName = "Dark Matter " .. petName end
        if pet.nk then petName = petName .. " (" .. pet.nk .. ")" end
        local EnchantString = ""
        if pet.powers and #pet.powers > 0 then
            local Enchants = {}
            for _, p in ipairs(pet.powers) do
                local pName = p[1]
                local pLvl = p[2]
                local tierTitle = pName
                if Directory.Powers[pName] and Directory.Powers[pName].tiers and Directory.Powers[pName].tiers[pLvl] then
                    tierTitle = Directory.Powers[pName].tiers[pLvl].title
                end
                table.insert(Enchants, tierTitle)
            end
            EnchantString = " | " .. table.concat(Enchants, ", ")
        end
        local Btn = EnchantTab:Button({
            Text = "[Add] " .. petName .. EnchantString,
            Callback = function() AddUIDToInput(pet.uid) end
        })
        table.insert(PetButtons, { Button = Btn, Name = petName, UID = pet.uid })
    end
end

BuildEnchantList()
EnchantTab:Separator({ Text = "All Pets (click Add to select)" })
EnchantTab:Separator({ Text = "Pets" })
EnchantTab:InputText({
    Label = 'Search (name / nickname / uid)',
    PlaceHolder = 'Type here...',
    Value = "",
    Callback = function(self)
        SearchQuery = string.lower(self:GetValue() or "")
        for _, data in ipairs(PetButtons) do
            local match = true
            if SearchQuery ~= "" then
                match = string.find(string.lower(data.Name), SearchQuery, 1, true) ~= nil
                if not match then
                    match = string.find(string.lower(data.UID), SearchQuery, 1, true) ~= nil
                end
            end
            pcall(function() data.Button.Visible = match end)
        end
    end
})
BuildPetList()

local function PetHasDesiredEnchant(pet)
    for powerName, levels in pairs(TargetEnchants) do
        local has, lvl = Shared.HasPower(pet, powerName)
        if has and levels[tonumber(lvl)] then return true end
    end
    return false
end

local function UpdateEquippedPets()
    table.clear(EquippedPets)
    local equippedPets = PetCmds.GetEquipped(LocalPlayer)
    for _, pet in pairs(equippedPets) do
        if pet and pet.uid then table.insert(EquippedPets, pet.uid) end
    end
end

UpdateEquippedPets()

