local function MatchesPetName(pet, targetName)
    if not pet or not pet.id or targetName == "" then return false end
    local targetLower = string.lower(targetName)
    local petIdLower = string.lower(tostring(pet.id))
    if petIdLower == targetLower or string.find(petIdLower, targetLower, 1, true) then
        return true
    end
    local def = Directory.Pets and Directory.Pets[tostring(pet.id)]
    if def and def.name then
        local defNameLower = string.lower(tostring(def.name))
        if defNameLower == targetLower or string.find(defNameLower, targetLower, 1, true) then
            return true
        end
    end
    return false
end

local function CraftMachineRows(tableData, isRainbow)
    local saveData = Save.Get()
    local petsData = saveData and saveData.Pets
    if not petsData then return end

    local odds = isRainbow and ((Shared and Shared.RainbowMachineOdds) or {}) or ((Shared and Shared.GoldMachineOdds) or {})
    local remote = isRainbow and RainbowRemote or GoldenRemote
    local PetsDir = Directory.Pets or {}

    for _, rowData in ipairs(tableData) do
        local targetName = rowData.Name:GetValue()
        local customAmount = tonumber(rowData.Amount:GetValue())
        local amount = (customAmount and customAmount > 0) and customAmount or #odds

        if targetName ~= "" and amount > 0 then
            local groups = {}
            for _, pet in ipairs(petsData) do
                local def = PetsDir[tostring(pet.id)]
                if pet and pet.uid and not pet.l and def and MatchesPetName(pet, targetName) then
                    if not (def.isPremium or def.rarity == "Exclusive" or def.rarity == "Event" or def.isGift) then
                        local isGold = pet.g == true and not pet.r and not pet.dm and not pet.gh and not pet.mj
                        local isNormal = not pet.g and not pet.r and not pet.dm and not pet.gh and not pet.mj
                        local okVariant = isRainbow and isGold or isNormal

                        if okVariant then
                            local key = tostring(pet.id) .. "|" .. tostring(pet.sh == true) .. "|" .. tostring(pet.hc == true)
                            groups[key] = groups[key] or {}
                            table.insert(groups[key], pet.uid)
                        end
                    end
                end
            end

            for _, uidList in pairs(groups) do
                if #uidList >= amount then
                    local chosen = {}
                    for i = 1, amount do
                        chosen[i] = uidList[i]
                    end
                    task.spawn(function()
                        task.wait(0.1)
                        pcall(function() Network.Invoke(remote, chosen) end)
                    end)
                    break
                end
            end
        end
    end
end

local function FusePets()
    local saveData = Save.Get()
    local petsData = saveData and saveData.Pets
    if not petsData then return end

    for _, rowData in ipairs(FuseTableData) do
        local targetName = rowData.Name:GetValue()
        local targetVariant = rowData.Variant:GetValue()
        local amount = tonumber(rowData.Amount:GetValue())

        if targetName ~= "" and amount and amount > 0 then
            local matched = {}
            for _, pet in ipairs(petsData) do
                if pet and pet.uid and not pet.l and MatchesPetName(pet, targetName) then
                    local isGolden = pet.g == true
                    local isRainbow = pet.r == true
                    local isDefault = not isGolden and not isRainbow and not pet.dm

                    local variantMatch =
                        (targetVariant == "Default" and isDefault)
                        or (targetVariant == "Golden" and isGolden)
                        or (targetVariant == "Rainbow" and isRainbow)

                    if variantMatch then
                        table.insert(matched, pet.uid)
                    end
                end
            end

            if #matched >= amount then
                local uids = {}
                for i = 1, amount do
                    table.insert(uids, matched[i])
                end
                task.spawn(function()
                    task.wait(0.1)
                    pcall(function() Network.Invoke(FuseRemote, uids) end)
                end)
            end
        end
    end
end

local function BuildSimpleCraftTab(tab, tableData, savedRows, isRainbow, actionText, autoVarName, onAction)
    local tbl = tab:Table({
        RowBackground = true,
        Border = false,
        RowsFill = false,
        Size = UDim2.fromScale(1, 0)
    })

    local function createRow(data)
        data = data or {}
        local Row = tbl:CreateRow()

        local NameColumn = Row:CreateColumn()
        NameColumn.Size = UDim2.new(0.58, 0, 0, 30)
        local NameInput = NameColumn:InputText({
            PlaceHolder = "Pet Name",
            Value = data.Name or "",
            Size = UDim2.new(1, 0, 0, 30),
            Callback = function() SaveCurrentSettings() end
        })

        local AmountColumn = Row:CreateColumn()
        AmountColumn.Size = UDim2.new(0.24, 0, 0, 30)
        local AmountInput = AmountColumn:InputText({
            PlaceHolder = "Amount",
            Value = data.Amount or "",
            Size = UDim2.new(1, 0, 0, 30),
            Callback = function() SaveCurrentSettings() end
        })

        local DeleteColumn = Row:CreateColumn()
        DeleteColumn.Size = UDim2.new(0.18, 0, 0, 30)

        local rowData = {
            Name = NameInput,
            Mode = isRainbow and "Rainbow" or "Golden",
            Amount = AmountInput,
            Row = Row
        }
        table.insert(tableData, rowData)

        DeleteColumn:Button({
            Text = "Del",
            Size = UDim2.new(1, -4, 0, 28),
            Callback = function()
                Row:Remove()
                for i, v in ipairs(tableData) do
                    if v == rowData then
                        table.remove(tableData, i)
                        break
                    end
                end
                SaveCurrentSettings()
            end
        })

        return rowData
    end

    if #savedRows > 0 then
        for _, rData in ipairs(savedRows) do
            createRow(rData)
        end
    else
        createRow()
    end

    local actionRow = tab:Row()
    actionRow:Button({
        Text = "Add",
        Size = UDim2.new(0, 60, 0, 30),
        Callback = function()
            createRow()
            SaveCurrentSettings()
        end
    })
    actionRow:Button({
        Text = actionText,
        Size = UDim2.new(0, 80, 0, 30),
        Callback = function()
            onAction()
        end
    })

    local initialAuto = (autoVarName == "Golden" and AutoGolden)
        or (autoVarName == "Rainbow" and AutoRainbow)
        or false

    actionRow:Checkbox({
        Label = "Auto " .. actionText,
        Value = initialAuto,
        Callback = function(self, Value)
            if autoVarName == "Golden" then
                AutoGolden = Value
                _G.AutoGolden = Value
            elseif autoVarName == "Rainbow" then
                AutoRainbow = Value
                _G.AutoRainbow = Value
            end
            SaveCurrentSettings()
        end
    })
    actionRow:Fill()

    tab:Label({
        Text = "Empty Amount uses machine odds count",
        TextColor3 = Color3.fromRGB(200, 200, 200),
        Size = UDim2.new(1, 0, 0, 20)
    })
end

BuildSimpleCraftTab(GoldenTab, GoldenTableData, GoldenRows, false, "Golden", "Golden", function()
    CraftMachineRows(GoldenTableData, false)
end)

BuildSimpleCraftTab(RainbowTab, RainbowTableData, RainbowRows, true, "Rainbow", "Rainbow", function()
    CraftMachineRows(RainbowTableData, true)
end)

