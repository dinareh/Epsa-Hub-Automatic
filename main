    local VariantColumn = Row:CreateColumn()
    VariantColumn.Size = UDim2.new(0.28, 0, 0, 30)
    local VariantCombo = VariantColumn:Combo({
        Label = "",
        Items = {"Default", "Golden", "Rainbow"},
        Selected = data.Variant or "Default",
        Size = UDim2.new(1, 0, 0, 30),
        Callback = function() SaveCurrentSettings() end
    })

    local AmountColumn = Row:CreateColumn()
    AmountColumn.Size = UDim2.new(0.20, 0, 0, 30)
    local AmountInput = AmountColumn:InputText({
        PlaceHolder = "Amount",
        Value = data.Amount or "",
        Size = UDim2.new(1, 0, 0, 30),
        Callback = function() SaveCurrentSettings() end
    })

    local DeleteColumn = Row:CreateColumn()
    DeleteColumn.Size = UDim2.new(0.16, 0, 0, 30)

    local rowData = {
        Name = NameInput,
        Variant = VariantCombo,
        Amount = AmountInput,
        Row = Row
    }
    table.insert(FuseTableData, rowData)

    DeleteColumn:Button({
        Text = "Del",
        Size = UDim2.new(1, -4, 0, 28),
        Callback = function()
            Row:Remove()
            for i, v in ipairs(FuseTableData) do
                if v == rowData then
                    table.remove(FuseTableData, i)
                    break
                end
            end
            SaveCurrentSettings()
        end
    })

    return rowData
end

if #FuseRows > 0 then
