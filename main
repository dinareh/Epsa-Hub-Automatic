    return require(ReplicatedStorage.Framework.Library)
end)

if not Z then
    Library = require(ReplicatedStorage:WaitForChild("Library"))
end
local Network = Library.Network
local PetCmds = Library.PetCmds
local LocalPlayer = game:GetService("Players").LocalPlayer

--// Tables
local Orbs = {}
local EquippedPets = {}

--// Remote Finder, fully ai block lol
local function FindRemote(Folder, ScriptName, RemoteType, ArgsCount, NameFilter)
    RemoteType = RemoteType or 'Invoke'
    local function findScript(Folder)
        for _, child in ipairs(Folder:GetChildren()) do
            if child.Name == ScriptName then
                return child
            end
            if child:IsA("Folder") or child:IsA("ModuleScript") then
                local found = findScript(child)
                if found then return found end
            end
        end
        return nil
    end
    
    local script = findScript(Folder)
    if not script then return nil end
    
    local source = pcall(decompile, script) and decompile(script)
    if not source or source == "" then return nil end
    
    local foundRemotes = {}
    local allRemotes = {}
    
    if RemoteType == 'Invoke' then
        for remote, args in source:gmatch('Network%.Invoke%(["\']([^"\']+)["\']%,%s*(.-)%)') do
            local count = 0
            for _ in args:gmatch("[^,]+") do count = count + 1 end
            table.insert(allRemotes, {name = remote, args = count, full = remote .. "(" .. count .. " args)"})
        end
        for remote in source:gmatch('Network%.Invoke%(["\']([^"\']+)["\']%)') do
            table.insert(allRemotes, {name = remote, args = 0, full = remote .. "(0 args)"})
        end
    else
        for remote, args in source:gmatch('Network%.Fire%(["\']([^"\']+)["\']%,%s*(.-)%)') do
            local count = 0
            for _ in args:gmatch("[^,]+") do count = count + 1 end
            table.insert(allRemotes, {name = remote, args = count, full = remote .. "(" .. count .. " args)"})
        end
        for remote in source:gmatch('Network%.Fire%(["\']([^"\']+)["\']%)') do
            table.insert(allRemotes, {name = remote, args = 0, full = remote .. "(0 args)"})
        end
    end
    
    if NameFilter and NameFilter ~= 'any' then
        for _, r in ipairs(allRemotes) do
            if string.lower(r.name):find(string.lower(NameFilter)) then
                table.insert(foundRemotes, r)
            end
        end
    else
        foundRemotes = allRemotes
    end
    
    if #foundRemotes == 0 then
        return nil
    end
    
    if ArgsCount == 'any' or ArgsCount == nil then
        return foundRemotes[1].name
    end
    
    for _, r in ipairs(foundRemotes) do
        if r.args == ArgsCount then
            return r.name
        end
    end  
    return nil
end

--// Remotes
local EggRemote = FindRemote(LocalPlayer.PlayerScripts, 'Eggs', 'Invoke', 'any', 'Buy') or 'Buy Egg'
local OrbsRemote = FindRemote(LocalPlayer.PlayerScripts, 'Orbs', 'Fire', 'any', 'Claim') or 'Claim Orbs'
local FarmCoinRemote = FindRemote(LocalPlayer.PlayerScripts, 'Pets', 'Fire', 'any', 'Farm') or 'Farm Coin'
local JoinCoinRemote = FindRemote(LocalPlayer.PlayerScripts, 'Pets', 'Invoke', 'any', 'Join') or 'Join Coin'
local GetCoinsRemote = FindRemote(LocalPlayer.PlayerScripts, 'Coins', 'Invoke', 'any', 'Get') or 'Get Coins'

--// Test
print(EggRemote, OrbsRemote, FarmCoinRemote, JoinCoinRemote, GetCoinsRemote)

if not EggRemote then return end
if not OrbsRemote then return end
if not FarmCoinRemote then return end
if not JoinCoinRemote then return end
if not GetCoinsRemote then return end

