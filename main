end)

task.spawn(function()
    while not _G.StopHub do
        task.wait(0.33)
        if ClaimOrbs then
            local orbsContainer = Library.Things:FindFirstChild("Orbs")
            if orbsContainer then
                for _, Orb in pairs(orbsContainer:GetChildren()) do table.insert(Orbs, Orb.Name) end
                if #Orbs > 0 then
                    Network.Fire(OrbsRemote, Orbs)
                    table.clear(Orbs)
                end
            end
        end
    end
end)

coroutine.wrap(function()
    while not _G.StopHub do
        if AutoFarm then
            UpdateEquippedPets()
            if #EquippedPets > 0 then
                local Success, GetCoins = pcall(function() return Network.Invoke(GetCoinsRemote) end)
                if Success and type(GetCoins) == "table" then
                    local RootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if RootPart then
                        local PlayerPos = RootPart.Position
                        local AllCoins, TargetCoins = {}, {}
                        for CoinId, CoinData in pairs(GetCoins) do
                            if CoinData and CoinData.p then
                                local ShouldFarm = true
                                local name = CoinData.n or ""
                                if FarmMode == "Gems" then
                                    if not (name:find("Diamond") or name:find("Gem")) then ShouldFarm = false end
                                elseif FarmMode == "Name" then
                                    if name:lower():find(TargetName:lower()) then
                                        table.insert(TargetCoins, { id = CoinId, dist = (PlayerPos - CoinData.p).Magnitude, name = name })
                                    end
                                    ShouldFarm = false
                                end
                                if ShouldFarm then
                                    table.insert(AllCoins, { id = CoinId, dist = (PlayerPos - CoinData.p).Magnitude })
                                end
                            end
                        end
                        local SelectedCoinId = nil
                        if FarmMode == "Name" then
                            if #TargetCoins > 0 then
                                table.sort(TargetCoins, function(a, b) return a.dist < b.dist end)
                                SelectedCoinId = TargetCoins[1].id
                            end
                        elseif FarmMode == "Nearest" then
                            table.sort(AllCoins, function(a, b) return a.dist < b.dist end)
                            local count = math.min(NearestCount, #AllCoins)
                            if count > 0 then SelectedCoinId = AllCoins[math.random(1, count)].id end
                        elseif FarmMode == "Random" then
                            if #AllCoins > 0 then SelectedCoinId = AllCoins[math.random(1, #AllCoins)].id end
                        elseif FarmMode == "Gems" then
                            table.sort(AllCoins, function(a, b) return a.dist < b.dist end)
                            local count = math.min(NearestCount, #AllCoins)
                            if count > 0 then SelectedCoinId = AllCoins[math.random(1, count)].id end
                        end
                        if SelectedCoinId then
                            pcall(function()
                                Network.Invoke(JoinCoinRemote, SelectedCoinId, EquippedPets)
                                for _, petUid in pairs(EquippedPets) do
                                    Network.Fire(FarmCoinRemote, SelectedCoinId, petUid)
                                end
                            end)
                        end
                    end
                end
            end
        end
        task.wait(0.05)
    end
end)()

task.spawn(function()
    while not _G.StopHub do
        task.wait(EnchantDelay)
        if not AutoEnchant then continue end
        local SelectedUIDs = GetSelectedUIDs()
        if #SelectedUIDs == 0 then continue end
        local Data = Save.Get()
        if not Data or not Data.Pets then continue end
        for _, petUid in ipairs(SelectedUIDs) do
            local petObj
            for _, p in ipairs(Data.Pets) do
                if p.uid == petUid then petObj = p; break end
            end
            if petObj and not PetHasDesiredEnchant(petObj) then
                pcall(function() Network.Invoke(EnchantRemote, petUid) end)
                task.wait(EnchantDelay)
                pcall(function() Save.Update(LocalPlayer) end)
                break
            end
        end
    end
end)

task.spawn(function()
    while not _G.StopHub do
        task.wait(0.5)
        if AutoFuse then
            FusePets()
        end
        if AutoGolden then
            CraftMachineRows(GoldenTableData, false)
        end
        if AutoRainbow then
            CraftMachineRows(RainbowTableData, true)
        end
    end
end)

