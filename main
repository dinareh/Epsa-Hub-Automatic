local SettingsFolder = 'EspaHubAutomatic'
local SettingsFilePath = SettingsFolder .. "/Settings.json"
local http = game:GetService("HttpService")

local function GetSettingsPath()
    if isfolder and makefolder and writefile and readfile then
        if not isfolder(SettingsFolder) then makefolder(SettingsFolder) end
        return SettingsFilePath
    end
    return nil
end

local DefaultSettings = {
    AutoBuyEgg = false, AutoBuyEgg2 = false, x3Eggs = false, x8Eggs = false,
    MaxEggs = false, AutoFarm = false, ClaimOrbs = false,
    EggName = 'Cracked Egg', EggDelay = 1, EggAmount = 1,
    FarmMode = 'Nearest', NearestCount = 10, TargetName = 'Chest',
    AutoEnchant = false, EnchantDelay = 1.5, SelectedUIDs = "", TargetEnchants = {},
    GoldenRows = {}, AutoGolden = false,
    RainbowRows = {}, AutoRainbow = false,
    FuseRows = {}, AutoFuse = false
}

local function LoadSettings()
    local path = GetSettingsPath()
    if path and isfile(path) then
        local success, data = pcall(function() return http:JSONDecode(readfile(path)) end)
        if success and type(data) == "table" then return data end
    end
    return {}
end

local SavedSettings = LoadSettings()
local Settings = {}
for k, v in pairs(DefaultSettings) do
    if SavedSettings[k] ~= nil then
        Settings[k] = SavedSettings[k]
    elseif type(v) == "table" then
        Settings[k] = {}
    else
        Settings[k] = v
    end
end

local EggName = Settings.EggName
local EggDelay = Settings.EggDelay
local EggAmount = Settings.EggAmount
local FarmMode = Settings.FarmMode
local NearestCount = Settings.NearestCount
local TargetName = Settings.TargetName
local AutoBuyEgg = Settings.AutoBuyEgg
local AutoBuyEgg2 = Settings.AutoBuyEgg2
local x3Eggs = Settings.x3Eggs
local x8Eggs = Settings.x8Eggs
local MaxEggs = Settings.MaxEggs
local AutoFarm = Settings.AutoFarm
local ClaimOrbs = Settings.ClaimOrbs
local AutoEnchant = Settings.AutoEnchant
local EnchantDelay = Settings.EnchantDelay
local SelectedUIDsSaved = tostring(Settings.SelectedUIDs or "")
local TargetEnchants = type(Settings.TargetEnchants) == "table" and Settings.TargetEnchants or {}
local GoldenRows = type(Settings.GoldenRows) == "table" and Settings.GoldenRows or {}
local AutoGolden = Settings.AutoGolden == true
local RainbowRows = type(Settings.RainbowRows) == "table" and Settings.RainbowRows or {}
local AutoRainbow = Settings.AutoRainbow == true
local FuseRows = type(Settings.FuseRows) == "table" and Settings.FuseRows or {}
local AutoFuse = Settings.AutoFuse == true

local UIDInput = nil
local GoldenTableData = {}
local RainbowTableData = {}
local FuseTableData = {}

local function CollectCraftRows(tableData, defaultMode)
    local rows = {}
    for _, rowData in ipairs(tableData) do
        table.insert(rows, {
            Name = rowData.Name and rowData.Name:GetValue() or "",
            Mode = defaultMode,
            Amount = rowData.Amount and rowData.Amount:GetValue() or ""
        })
    end
    return rows
end

local function CollectFuseRows()
    local rows = {}
    for _, rowData in ipairs(FuseTableData) do
        table.insert(rows, {
            Name = rowData.Name and rowData.Name:GetValue() or "",
            Variant = rowData.Variant and rowData.Variant:GetValue() or "Default",
            Amount = rowData.Amount and rowData.Amount:GetValue() or ""
        })
    end
    return rows
end

local function SaveCurrentSettings()
    Settings.AutoBuyEgg = AutoBuyEgg
    Settings.AutoBuyEgg2 = AutoBuyEgg2
    Settings.x3Eggs = x3Eggs
    Settings.x8Eggs = x8Eggs
    Settings.MaxEggs = MaxEggs
    Settings.AutoFarm = AutoFarm
    Settings.ClaimOrbs = ClaimOrbs
    Settings.EggName = EggName
    Settings.EggDelay = EggDelay
    Settings.EggAmount = EggAmount
    Settings.FarmMode = FarmMode
    Settings.NearestCount = NearestCount
    Settings.TargetName = TargetName
    Settings.AutoEnchant = AutoEnchant
    Settings.EnchantDelay = EnchantDelay
    if UIDInput then
        SelectedUIDsSaved = UIDInput:GetValue() or ""
    end
    Settings.SelectedUIDs = SelectedUIDsSaved
    Settings.TargetEnchants = TargetEnchants

    if #GoldenTableData > 0 then
        GoldenRows = CollectCraftRows(GoldenTableData, "Golden")
    end
    Settings.GoldenRows = GoldenRows
    Settings.AutoGolden = AutoGolden

    if #RainbowTableData > 0 then
        RainbowRows = CollectCraftRows(RainbowTableData, "Rainbow")
    end
    Settings.RainbowRows = RainbowRows
    Settings.AutoRainbow = AutoRainbow

    if #FuseTableData > 0 then
        FuseRows = CollectFuseRows()
    end
    Settings.FuseRows = FuseRows
    Settings.AutoFuse = AutoFuse

    local path = GetSettingsPath()
    if path then
        pcall(function() writefile(path, http:JSONEncode(Settings)) end)
    end
end

_G.SaveAllCustomData = SaveCurrentSettings

