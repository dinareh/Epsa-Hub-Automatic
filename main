--// Farm Mode Combo
local FarmModes = {"Nearest", "Random", "Gems", "Name"}
local CurrentFarmMode = 1
for i, Mode in ipairs(FarmModes) do
    if Mode == FarmMode then
        CurrentFarmMode = i
        break
    end
end

MainTab:Combo({
    Label = 'Farm Mode',
    Items = FarmModes,
    Selected = FarmModes[CurrentFarmMode],
    Callback = function(self, Value)
        FarmMode = Value
        SaveCurrentSettings()
    end
})

MainTab:InputText({
    Label = 'Nearest Count',
    PlaceHolder = '10',
    Value = tostring(NearestCount),
    Callback = function(self)
        local val = tonumber(self:GetValue())
        if val then
            NearestCount = val
            SaveCurrentSettings()
        end
    end
})

--// Target Name
MainTab:InputText({
    Label = 'Target Name',
    PlaceHolder = 'Chest, Diamond, Present',
    Value = TargetName,
    Callback = function(self)
        TargetName = self:GetValue()
        SaveCurrentSettings()
    end
})

--// Equipped Pets System
local function UpdateEquippedPets()
    table.clear(EquippedPets)
    local equippedPets = PetCmds.GetEquipped(LocalPlayer)
    for _, pet in pairs(equippedPets) do
        if pet and pet.uid then
            table.insert(EquippedPets, pet.uid)
        end
    end
end

UpdateEquippedPets()

--// Auto Buy Egg System (Method 1)
task.spawn(function()
    while not _G.StopHub do
        task.wait(EggDelay)
        if AutoBuyEgg then
            Network.Invoke(EggRemote, EggName, x3Eggs, x8Eggs, MaxEggs)
        end
    end
end)

--// Auto Buy Egg System (Method 2)
task.spawn(function()
    while not _G.StopHub do
        task.wait(EggDelay)
        if AutoBuyEgg2 then
            Network.Invoke(EggRemote, EggName, EggAmount)
        end
    end
end)

--// Claim Orbs System
task.spawn(function()
    while not _G.StopHub do
        task.wait(0.33)
        if ClaimOrbs then
            local orbsContainer = Library.Things:FindFirstChild("Orbs")
            if orbsContainer then
                for _, Orb in pairs(orbsContainer:GetChildren()) do
                    table.insert(Orbs, Orb.Name)
                end
                
                if #Orbs > 0 then
                    Network.Fire(OrbsRemote, Orbs)
                    table.clear(Orbs)
                end
            end
        end
    end
end)

--// Auto Farm System
coroutine.wrap(function()
    while not _G.StopHub do
        if AutoFarm then
            UpdateEquippedPets()
            if #EquippedPets > 0 then
                local Success, GetCoins = pcall(function()
                    return Network.Invoke(GetCoinsRemote)
                end)
                
                if Success and type(GetCoins) == "table" then
                    local RootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    
                    if RootPart then
                        local PlayerPos = RootPart.Position
                        local AllCoins = {}
                        local TargetCoins = {}
                        
                        for CoinId, CoinData in pairs(GetCoins) do
                            if CoinData and CoinData.p then
                                local ShouldFarm = true
                                local name = CoinData.n or ""
                                
                                if FarmMode == "Gems" then
                                    if not (name:find("Diamond") or name:find("Gem")) then
                                        ShouldFarm = false
                                    end
                                elseif FarmMode == "Name" then
                                    if name:lower():find(TargetName:lower()) then
                                        table.insert(TargetCoins, {
                                            id = CoinId,
                                            dist = (PlayerPos - CoinData.p).Magnitude,
                                            name = name
                                        })
                                    end
                                    ShouldFarm = false
                                end
                                
                                if ShouldFarm then
                                    local Dist = (PlayerPos - CoinData.p).Magnitude
                                    table.insert(AllCoins, { id = CoinId, dist = Dist })
                                end
                            end
                        end
                        
                        local SelectedCoinId = nil
                        
                        if FarmMode == "Name" then
                            if #TargetCoins > 0 then
                                table.sort(TargetCoins, function(a, b) return a.dist < b.dist end)
                                SelectedCoinId = TargetCoins[1].id
                            end
                        elseif FarmMode == "Nearest" then
                            table.sort(AllCoins, function(a, b) return a.dist < b.dist end)
                            local count = math.min(NearestCount, #AllCoins)
                            if count > 0 then
                                SelectedCoinId = AllCoins[math.random(1, count)].id
                            end
                        elseif FarmMode == "Random" then
                            if #AllCoins > 0 then
                                SelectedCoinId = AllCoins[math.random(1, #AllCoins)].id
                            end
                        elseif FarmMode == "Gems" then
                            table.sort(AllCoins, function(a, b) return a.dist < b.dist end)
                            local count = math.min(NearestCount, #AllCoins)
                            if count > 0 then
                                SelectedCoinId = AllCoins[math.random(1, count)].id
                            end
                        end
                        
                        if SelectedCoinId then
                            pcall(function()
                                Network.Invoke(JoinCoinRemote, SelectedCoinId, EquippedPets)
                                for _, petUid in pairs(EquippedPets) do
                                    Network.Fire(FarmCoinRemote, SelectedCoinId, petUid)
                                end
                            end)
                        end
                    end
                end
            end
        end
        task.wait(0.05)
    end
end)()

print("Espa Hub Automatic Loaded!")
